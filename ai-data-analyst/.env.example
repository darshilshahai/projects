APP_NAME=QueryMint
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

DATASET_STORAGE_PATH=storage/datasets
MAX_UPLOAD_SIZE_MB=25
CSV_SAMPLE_ROWS=5
CSV_PREVIEW_ROWS=20

MAX_QUERY_ROWS=200
MAX_TOOL_ITERATIONS=3

OPENAI_INPUT_PRICE_PER_MILLION=2.50
OPENAI_CACHED_INPUT_PRICE_PER_MILLION=0.25
OPENAI_OUTPUT_PRICE_PER_MILLION=15.00