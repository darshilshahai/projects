# Project Settings → API → Project URL (NOT the postgres connection string)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional for modern projects (ES256 JWKS). Only required for legacy HS256 JWT secret.
SUPABASE_JWT_SECRET=
# Database connection (Settings → Database). Used by: python scripts/apply_schema.py
# Percent-encode special characters in the password.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
CORS_ORIGINS=http://localhost:3000
