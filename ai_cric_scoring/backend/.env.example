APP_NAME=Cricket Intelligence API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://cricket:cricket@localhost:5433/cricket_db
TEST_DATABASE_URL=postgresql+asyncpg://cricket:cricket@localhost:5433/cricket_test_db

LOG_LEVEL=INFO

CORS_ORIGINS=http://localhost:3000,http://localhost:8080

JWT_SECRET_KEY=replace-me-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
